# ─────────────────────────────────────────────────────────────────────────────
# EduShield AI — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
.env/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.nox/
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*.cover
*.log
htmlcov/
.pytest_cache/
.mypy_cache/
.dmypy.json
dist/
build/
*.egg-info/
*.egg
MANIFEST
*.so

# ── Node.js / Frontend ────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ── Vite Build Artifacts ──────────────────────────────────────────────────────
frontend/dist/
frontend/.vite/

# ── Docker ────────────────────────────────────────────────────────────────────
# Never commit Docker override or local compose overrides
docker-compose.override.yml

# ── IDEs & Editors ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
*.orig

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*

# ── Temporary / OS Files ──────────────────────────────────────────────────────
tmp/
temp/
.tmp/
*.tmp
*.bak
*.swp
*~

# ── Test Artifacts ────────────────────────────────────────────────────────────
htmlcov/
.coverage
*.cover
junit.xml
test-results/

# ── Local Reports & Documentation ─────────────────────────────────────────────
PROJECT_REPORT.md
